{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:strict": "E2E_REQUIRE_DB=1 playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../.env.local -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@bagsfm/bags-sdk": "^1.3.7",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@repo/lib": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@solana/codecs-numbers": "6.9.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.9",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.12.0",
    "nanoid": "^5.0.9",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.54.2",
    "rpc-websockets": "9.3.9",
    "sonner": "^2.0.7",
    "tweetnacl": "^1.0.3",
    "workflow": "^4.2.4",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/bs58": "^4.0.4",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.9.0",
    "pg": "^8.13.1",
    "smee-client": "^5.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^6",
    "vitest": "^4.1.5"
  }
}

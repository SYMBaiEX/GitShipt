{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev -- --port $PORT",
  "outputDirectory": "apps/web/.next",
  "fluid": true,
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/cron/index-github", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/snapshot", "schedule": "0 0 * * *" },
    { "path": "/api/cron/health", "schedule": "0 0 * * 0" },
    { "path": "/api/cron/publish-kpis", "schedule": "0 1 * * 0" },
    { "path": "/api/cron/audit-chain", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/rebalance-bps", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/claim-partner-fees", "schedule": "30 0 * * *" },
    { "path": "/api/cron/revalidate-bot-flags", "schedule": "0 3 * * 0" },
    { "path": "/api/cron/reconcile-funds", "schedule": "15 2 * * *" }
  ]
}

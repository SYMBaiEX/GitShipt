{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" bun run --bun next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:strict": "E2E_REQUIRE_DB=1 playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../.env.local -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@bagsfm/bags-sdk": "^1.4.4",
    "@hookform/resolvers": "^7.0.7",
    "@neondatabase/serverless": "^1.2.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@repo/lib": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "^1.7.25",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.74.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "otpauth": "^9.6.0",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tweetnacl": "^1.0.3",
    "workflow": "^5.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@repo/bigint-buffer": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/bs58": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "smee-client": "^5.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
